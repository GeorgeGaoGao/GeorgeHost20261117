<Popup x:Class="Company.Core.Dialog.DSPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--
        内容自适应宽度（MinWidth/MaxWidth），长文本换行，不再固定 400x100。
        文本绑定在构造函数里用显式 Source 完成，XAML 里不需要 RelativeSource 查找。
    -->
    <Border Background="Gray" CornerRadius="10" Padding="24,16"
            MinWidth="240" MaxWidth="480" MinHeight="72"
            IsHitTestVisible="False" UseLayoutRounding="True">
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="18" Foreground="White"/>
    </Border>
</Popup>

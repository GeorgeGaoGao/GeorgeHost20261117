<Popup x:Class="Company.Core.Dialog.BusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog"
             mc:Ignorable="d" AllowsTransparency="True" StaysOpen="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="Gray" CornerRadius="6" Padding="28,18" Width="300" Height="100" IsHitTestVisible="False">
        <TextBlock Text="{Binding Message}" Foreground="White" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
</Popup>

<Popup x:Class="Company.Core.Dialog.GeorgePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog"
             mc:Ignorable="d" AllowsTransparency="True" StaysOpen="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid IsHitTestVisible="False">
        <Border Width="300" Height="100" MaxWidth="300" CornerRadius="10" Background="Gray">
            <TextBlock Text="{Binding Information}" FontSize="18" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Popup>

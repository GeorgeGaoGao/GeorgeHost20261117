<Popup x:Class="Company.Core.Dialog.GeorgePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog" PopupAnimation="None"
             mc:Ignorable="d" AllowsTransparency="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid IsHitTestVisible="False">
        <Border MaxWidth="420" Padding="16,10" CornerRadius="6" Background="#CC202020">
            <TextBlock Text="{Binding Message, ElementName=Root}"
                   Foreground="White" TextWrapping="Wrap"/>
        </Border>


        <!--<Border x:Name="RootBorder"
            MaxWidth="420" Width="400" Height="100"
            Padding="16,10"
            CornerRadius="6"
            Background="Gray">
            <TextBlock Text="{Binding Message}"
                   Foreground="White"
                   FontSize="18"
                   TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>-->
    </Grid>
</Popup>

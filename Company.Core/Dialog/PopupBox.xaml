<Popup x:Class="Company.Core.Dialog.PopupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog"
             mc:Ignorable="d" AllowsTransparency="True" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid IsHitTestVisible="False">
        <Border Background="Gray" Width="400" Height="100" CornerRadius="10" >
            <TextBlock Text="{Binding Message}" Foreground="White" FontSize="18" TextWrapping="WrapWithOverflow"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Popup>

<Popup x:Class="Company.Core.Dialog.MyPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       AllowsTransparency="True"
       StaysOpen="True">
    <!--
        外层 Grid 的 Margin 是给阴影留的空间：Popup 子窗口的尺寸 = 内容尺寸，
        不留白的话 DropShadowEffect 会被窗口边界裁掉。
        亮底深字：在深色界面上对比度约 17:1，淡出过程肉眼可辨。
    -->
    <Grid x:Name="Root" Margin="20" IsHitTestVisible="False" UseLayoutRounding="True">
        <Border CornerRadius="8"
                Background="gray"
                BorderBrush="#33000000" BorderThickness="1"
                MinWidth="220" MaxWidth="520"
                Width="400" Height="100"
                Padding="20,14">
            <!--<Border.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="16" Opacity="0.45"/>
            </Border.Effect>-->
            <TextBlock x:Name="MessageText"
                       Foreground="white"
                       FontSize="17"
                       TextWrapping="Wrap"
                       TextAlignment="Center" LineHeight="24" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Popup>
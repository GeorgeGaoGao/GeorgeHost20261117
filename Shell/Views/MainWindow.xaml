<Window x:Class="Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True" FontSize="24"
        xmlns:share="clr-namespace:Company.Application.Share.Prism;assembly=Company.Application.Share"
        Title="{Binding Title}" Height="350" Width="525" >
    <StackPanel>
        <ContentControl prism:RegionManager.RegionName="MainRegion" />
        <TextBlock>
            <Run Text="Module Path: " />
            <Run Text="{x:Static share:ModuleNames.ModulePath}" />
        </TextBlock>
    </StackPanel>
</Window>
